# Copy this file to .env and fill it in:   cp .env.example .env
# .env is in .gitignore, so your keys never get committed.

# Which AI rates the coins: anthropic | openai | none
AI_PROVIDER=anthropic

# Paste ONE key, for the provider you picked above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: a specific model name. Blank = the default in ai.py.
AI_MODEL=

# Optional: any OpenAI-compatible server (a local model, another vendor).
# Use with AI_PROVIDER=openai.  Example: http://localhost:11434/v1
AI_BASE_URL=

# Filters - which coins are worth asking the AI about
MIN_LIQUIDITY_USD=20000
MIN_VOLUME_24H_USD=50000
MIN_AGE_HOURS=1
MAX_AGE_HOURS=72
MAX_RUGCHECK_SCORE=5000

# Cost guard: the most AI calls one scan is allowed to make
MAX_AI_CALLS_PER_SCAN=10
